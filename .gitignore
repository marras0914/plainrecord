node_modules/
dist/
# The Spanish build's scratch dir. build_locales.mjs sends the /es/ vite build
# here rather than into dist/, because emptyOutDir would otherwise have it wipe
# the English build; its assets are merged into dist/ afterwards. Output, and
# a near-duplicate of dist/ at that -- it has no business in history.
.locale-es/
.vercel/
.DS_Store

# Working data (scripts/paths.ts WORK_DIR). Build inputs, not deliverables:
# tx_bills_89R.json is 35 MB and tx_reconcile_89R.json is 16 MB, against a 53 KB
# quiz payload. Only public/data/quiz_89R.json is committed, because only it ships.
#
# Two details are load-bearing here:
#   - the leading slash: a bare `data/` matches at ANY depth, which would also
#     swallow public/data/ and un-commit the one file the site needs;
#   - `/data/*` and not `/data/`: git does not descend into an excluded
#     DIRECTORY, so a `!` exception below it never gets a chance to match.
#     Excluding the contents keeps the directory itself visible.
/data/*

# ...except the veto evidence. It is 117 KB, it is derived from a public Legislative
# Reference Library page, and it is the only input to the assertions that encode
# the SB 3 finding (a Patrick priority bill vetoed by Abbott — a documented
# intra-Republican split). Without it committed, `npm test` is red on a fresh
# clone, which makes the whole suite untrustworthy to anyone who did not build
# the 51 MB of bulk inputs first.
!/data/tx_evidence_vetoes.json

# Belt and braces: these used to live in the ship dir before the WORK_DIR split,
# so a stale script or an old checkout can still drop them there.
public/data/tx_bills_*.json
public/data/tx_reconcile_*.json
public/data/tx_roster_*.json
public/data/tx_review_*.json
public/data/tx_evidence_*.json
public/data/tx_flips_*.json

# Raw sources: LegiScan archives, Open States extracts, Journal PDFs and text.
raw/
journals/

# Single-file share build, generated from dist/ by scripts/build_artifact.mjs
share/

# Local scratch notes, not part of the project. Kept on disk, out of history.
/vikki goodwin.txt

.vercel

# Generated by scripts/i18n_review.mjs from i18n/copy.json. Regenerate with
# `npm run i18n:review` rather than editing or committing it.
i18n/review.html

# Generated by scripts/build_locales.mjs from the emitted locale list, so it
# cannot forget /es. Do not hand-maintain it.
public/sitemap.xml

# Backups written by the in-place payload editors (data:plain, data:categories).
# The payload is regenerable and version-controlled; a .bak beside it is a local
# safety net for the moment of the edit, not something to commit.
*.json.bak

.env*.local

# Never commit outreach or correspondence. See side-piece/rightnleft-outreach/
Jesse-responded.md
rightnleft-*.md
